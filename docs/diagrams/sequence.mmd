sequenceDiagram
    participant V as View (Activity)
    participant VM as TaskViewModel
    participant R as TaskRepository
    participant API as REST API (GET /todos)

    Note over V,API: Initial fetch & state flow
    V->>VM: fetchTasks(isRefresh = false)
    VM->>V: emit Loading state
    VM->>R: getTasks()
    R->>API: GET /todos
    alt Successful response with tasks
        API-->>R: 200 OK with TodoDto list
        R-->>VM: Result.Success(tasks)
        VM-->>V: emit Success(tasks)
    else Successful response with empty list
        API-->>R: 200 OK with empty list []
        R-->>VM: Result.Success(emptyList)
        VM-->>V: emit Empty state
    else Request or Network Failure
        API-->>R: IOException / HttpException / Parsing error
        R-->>VM: Result.Error(exception)
        alt Cached tasks exist in memory
            VM-->>V: emit Success(cachedTasks, errorMessage)
        else No cached tasks exist
            VM-->>V: emit Error(message)
        end
    end

    Note over V,API: Refresh flow
    V->>VM: fetchTasks(isRefresh = true)
    alt Cached tasks exist
        VM-->>V: emit Success(cachedTasks, isRefreshing = true)
    else No cached tasks
        VM-->>V: emit Loading state
    end
    VM->>R: getTasks()
    R->>API: GET /todos
    alt Refresh success
        API-->>R: 200 OK with updated tasks
        R-->>VM: Result.Success(tasks)
        VM-->>V: emit Success(tasks)
    else Refresh failure
        API-->>R: Network/Server/Parsing error
        R-->>VM: Result.Error(exception)
        VM-->>V: emit Success(cachedTasks, errorMessage)
    end
